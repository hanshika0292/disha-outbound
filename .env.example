# Copy to .env and fill in. Every value below is a placeholder.

# ── Runtime ──────────────────────────────────────────────────────────────────
# dev | test | staging | production (`disha db reset` refuses to run in production)
DISHA_ENV=dev
# Python log level for API, worker and CLI
DISHA_LOG_LEVEL=INFO
# text (readable) or json (one object per line, for log shipping)
DISHA_LOG_FMT=text

# ── Postgres (read by docker-compose.yml and `disha db reset`) ──────────────
# Superuser for the local container
POSTGRES_USER=postgres
# Superuser password for the local container
POSTGRES_PASSWORD=postgres
# Database name
POSTGRES_DB=disha
# Host port the container publishes
POSTGRES_PORT=5432
# Password for the disha_admin role (BYPASSRLS), created by db/init/01-roles.sh
DISHA_ADMIN_PASSWORD=change_me_admin
# Password for the disha_app role (RLS enforced), created by db/init/01-roles.sh
DISHA_APP_PASSWORD=change_me_app

# ── Database URLs used by the app ───────────────────────────────────────────
# Admin role: migrations, seeds, worker, auth lookups
DATABASE_URL_ADMIN=postgresql+asyncpg://disha_admin:change_me_admin@localhost:5432/disha
# App role: tenant-scoped API requests (RLS applies)
DATABASE_URL_APP=postgresql+asyncpg://disha_app:change_me_app@localhost:5432/disha

# ── Secrets ─────────────────────────────────────────────────────────────────
# Fernet key that encrypts stored credentials and lead emails.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DISHA_FERNET_KEY=replace_with_generated_fernet_key
# Master bearer token (admin on the 'demo' tenant) and HMAC key for user tokens and OAuth state.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DISHA_UI_TOKEN=replace_with_long_random_string

# ── Platform LLM keys (fallback when a tenant has no BYOK key) ──────────────
# Google AI Studio key; the default router sends all calls to Gemini
GEMINI_API_KEY=
# Anthropic console key (provider adapter exists, not used by default routing)
ANTHROPIC_API_KEY=
# OpenAI platform key (provider adapter exists, not used by default routing)
OPENAI_API_KEY=

# ── Public URLs ─────────────────────────────────────────────────────────────
# Where the API is reachable; used to build the Gmail OAuth callback URL
DISHA_API_URL=http://localhost:8000
# Where the web UI is reachable; used in redirects, login links and notification emails
DISHA_UI_URL=http://localhost:3000

# ── API server (`disha server`) ─────────────────────────────────────────────
# These four are read from the process environment only (Fly [env], docker
# compose, or `export`); the app does not load them from .env.
# Bind address
DISHA_HOST=127.0.0.1
# Bind port
DISHA_PORT=8000
# Uvicorn worker processes
DISHA_WORKERS=1
# Comma-separated CORS origins allowed to call the API (default: localhost:3000,3001)
DISHA_ALLOWED_ORIGINS=http://localhost:3000

# ── Background worker (`disha worker`) ──────────────────────────────────────
# Seconds between sequencer ticks (draft + send due steps)
WORKER_SEQUENCE_INTERVAL=900
# Seconds between Gmail reply polls
WORKER_POLL_INTERVAL=300

# ── Gmail (send + reply capture) ────────────────────────────────────────────
# OAuth client ID from Google Cloud Console > APIs & Services > Credentials
GMAIL_CLIENT_ID=
# OAuth client secret for the client above
GMAIL_CLIENT_SECRET=

# ── Lead sourcing and enrichment (optional) ─────────────────────────────────
# serper.dev Google Search API key; powers the "web" sourcing provider and enrichment
SERPER_API_KEY=
# hunter.io key for email finding/verification; optional, falls back to pattern guesses
HUNTER_API_KEY=

# ── LinkedIn via Unipile (optional) ─────────────────────────────────────────
# Unipile API key from the Unipile dashboard
UNIPILE_API_KEY=
# Your Unipile account DSN (base URL), e.g. https://apiXX.unipile.com:PORT
UNIPILE_DSN=

# ── Notion (optional) ───────────────────────────────────────────────────────
# Internal integration token; read from the process env by `disha notion auth`, which stores it encrypted
NOTION_TOKEN=

# ── Tests ───────────────────────────────────────────────────────────────────
# Process env only: DISHA_RUN_LIVE_LLM=1 GEMINI_API_KEY=... uv run pytest tests/test_live_gemini.py
DISHA_RUN_LIVE_LLM=0

# ── docker-compose.prod.yml only ────────────────────────────────────────────
# Role passwords passed to the prod Postgres container and DB URLs
ADMIN_PASSWORD=
APP_PASSWORD=
# Host ports for the API and UI containers
DISHA_PUBLIC_PORT=8000
UI_PUBLIC_PORT=3000
# API URL baked into the UI image at build time
NEXT_PUBLIC_API_BASE=http://localhost:8000
