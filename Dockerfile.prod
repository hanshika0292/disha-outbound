# syntax=docker/dockerfile:1.7
# Multi-stage production image. ~120 MB final, no build tooling.

FROM python:3.11-slim AS builder
# Build in /app so venv absolute paths match the final image location.
WORKDIR /app
RUN pip install --no-cache-dir uv==0.7.17
COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
RUN uv sync --frozen --no-dev


FROM python:3.11-slim
WORKDIR /app

# Copy resolved venv — paths already correct because builder used /app too.
COPY --from=builder /app/.venv /app/.venv
COPY src/ src/
COPY alembic/ alembic/
COPY alembic.ini ./
COPY db/ db/
COPY scripts/ scripts/

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
ENV PYTHONUNBUFFERED=1

# Non-root user
RUN useradd -m -u 1000 disha && chown -R disha:disha /app
USER disha

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys; \
    r=urllib.request.urlopen('http://localhost:8000/health',timeout=4); \
    sys.exit(0 if r.status<500 else 1)" || exit 1

CMD ["disha", "server", "--host", "0.0.0.0", "--port", "8000"]
